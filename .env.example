BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user ids that can run commands and are never punished
OWNER_IDS=123456789,987654321
# Optional extra never-punished ids (no command access), comma-separated
IMMUNE_IDS=
NSFW_THRESHOLD=0.55
# Optional. Only set this if another bot already uses /kick /help (e.g. COMMAND_PREFIX=kh_)
# COMMAND_PREFIX=
# Optional. On a host, point this at a persistent disk (e.g. /data)
# DATA_DIR=
