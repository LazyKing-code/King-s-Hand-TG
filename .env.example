BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user ids that can run commands and are never punished
OWNER_IDS=123456789,987654321
# Optional extra never-punished ids (no command access), comma-separated
IMMUNE_IDS=
NSFW_THRESHOLD=0.55
# Optional. Improves /ask web results on Railway. Not required — /ask works without it.
# Free key: https://brave.com/search/api/
# BRAVE_API_KEY=
# Optional. Only set this if another bot already uses /kick /help (e.g. COMMAND_PREFIX=kh_)
# COMMAND_PREFIX=
# Optional. On a host, point this at a persistent disk (e.g. /data)
# DATA_DIR=/data
# Railway: mount one volume at /data, set DATA_DIR=/data, and run ONLY ONE replica.
# Back up with: python scripts/backup_db.py   or owner command /backupdb
# OWNER_IDS = bot operators (immune + owner commands everywhere)
# IMMUNE_IDS = never punished, but no owner commands (use for friends)
